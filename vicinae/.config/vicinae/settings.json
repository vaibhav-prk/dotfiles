// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "pop_to_root_on_close": true,
   "escape_key_behavior": "close_window",
   "keybinding": "vim",
   "tray": {
      "enabled": false
   },
   "font": {
      "normal": {
         "family": "JetBrainsMono Nerd Font",
         "size": 10.5
      }
   },
   "theme": {
      "dark": {
         "name": "catppuccin-frappe"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "compact_mode": {
         "enabled": true
      }
   },
   "providers": {
      "@tinkerbells/store.vicinae.pass": {
         "preferences": {
            "passwordStorePath": "~/.password-store",
            "additionalPath": "",
            "otpAfterPassword": true,
            "lastUsedTtl": "120",
            "action": "paste"
         }
      },
      "ai": {
         "enabled": false
      },
      "browser-extension": {
         "enabled": false
      },
      "calculator": {
         "enabled": true
      },
      "core": {
         "entrypoints": {
            "open-config-file": {
               "enabled": false
            },
            "open-default-config": {
               "enabled": false
            },
            "reload-scripts": {
               "enabled": false
            },
            "report-bug": {
               "enabled": false
            },
            "settings": {
               "enabled": false
            },
            "show-logs": {
               "enabled": false
            },
            "sponsor": {
               "enabled": false
            },
            "store": {
               "enabled": true
            }
         }
      },
      "developer": {
         "enabled": false,
         "entrypoints": {
            "create": {
               "enabled": false
            }
         }
      },
      "dictation": {
         "enabled": false
      },
      "files": {
         "enabled": false,
         "preferences": {
            "autoIndexing": false,
            "indexingPaths": [
               "/home/vaibhav"
            ],
            "excludedIndexingPaths": []
         }
      },
      "font": {
         "enabled": false,
         "entrypoints": {
            "browse": {
               "enabled": true
            }
         }
      },
      "media": {
         "enabled": false
      },
      "power": {
         "enabled": false
      },
      "raycast-compat": {
         "enabled": false
      },
      "snippets": {
         "enabled": false,
         "preferences": {
            "enabled": true,
            "undo": true,
            "layout": "",
            "prePasteDelay": "0",
            "keyDelay": "2"
         }
      },
      "system": {
         "entrypoints": {
            "set-default-browser": {
               "enabled": false
            },
            "set-default-terminal": {
               "enabled": false
            }
         }
      },
      "theme": {
         "enabled": false,
         "entrypoints": {
            "set": {
               "enabled": false
            }
         }
      }
   }
}